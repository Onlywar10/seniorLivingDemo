      "kind": "custom",
      "refersTo": "module-label",
      "description": "Violet annotation revealed in structure mode: module, editor, content type and lane.",
      "html": "<div class=\"ds-ml\" role=\"note\"><span class=\"ds-ml-k\">Module 1</span><span class=\"ds-ml-v\"><b>Daily Life</b></span><span class=\"ds-ml-k\">Editor</span><span class=\"ds-ml-v\">Life Enrichment Director &middot; Dining Services Director</span><span class=\"ds-ml-k\">Content type</span><span class=\"ds-ml-v\">Calendar events, menu items, photo posts</span><span class=\"ds-ml-k\">Lane</span><span class=\"ds-ml-v\"><span class=\"ds-lane ds-lane-fast\">Fast lane</span> Publishes immediately on an approved template.</span></div>",
      "css": ".ds-lane{display:inline-flex;align-items:center;padding:3px 10px;border-radius:999px;font-family:var(--font-body,\"Atkinson Hyperlegible Next\",system-ui,sans-serif);font-size:17px;font-weight:700;line-height:1.3;white-space:nowrap}.ds-lane-fast{background:#dff5e3;color:#0f5a27}.ds-lane-approval{background:#ffe9c2;color:#6e4300}.ds-lane-urgent{background:#ffd9d4;color:#7c1f18}.ds-ml{display:grid;grid-template-columns:auto 1fr;gap:6px 18px;align-items:start;background:var(--violet-tint,#eeedfb);color:#211c5c;border:2px dashed var(--violet-line,#9a92dd);border-radius:6px;padding:12px 16px;font-family:var(--font-body,\"Atkinson Hyperlegible Next\",system-ui,sans-serif);font-size:17px;line-height:1.4;max-width:720px}.ds-ml-k{font-weight:800;letter-spacing:.04em;text-transform:uppercase;font-size:15px;color:var(--violet,#4338a6);padding-top:3px}.ds-ml-v b{color:var(--violet,#4338a6)}"
