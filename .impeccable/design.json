      "css": ".ds-icon{width:1.15em;height:1.15em;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}.ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:10px 22px;border-radius:999px;font-family:var(--font-body,\"Atkinson Hyperlegible Next\",system-ui,sans-serif);font-size:18px;font-weight:700;text-decoration:none;cursor:pointer;white-space:nowrap;border:2px solid transparent;transition:transform .18s cubic-bezier(.16,1,.3,1),background .18s,color .18s}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid var(--forest,#1f4d3b);outline-offset:3px;border-radius:4px}.ds-btn-forest{background:var(--forest,#1f4d3b);color:#fff;border-color:var(--forest,#1f4d3b)}.ds-btn-forest:hover{background:var(--forest-deep,#153627);color:#fff}"
    },
    {
