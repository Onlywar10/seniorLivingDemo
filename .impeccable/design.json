  "components": [
    {
      "name": "Primary Button (Apricot)",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one apricot action per view: Book a visit.",
      "html": "<a class=\"ds-btn ds-btn-apricot\" href=\"#\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 10h18M8 3v4M16 3v4\"/></svg><span>Book a visit</span></a>",
      "css": ".ds-icon{width:1.15em;height:1.15em;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}.ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:10px 22px;border-radius:999px;font-family:var(--font-body,\"Atkinson Hyperlegible Next\",system-ui,sans-serif);font-size:18px;font-weight:700;text-decoration:none;cursor:pointer;white-space:nowrap;border:2px solid transparent;transition:transform .18s cubic-bezier(.16,1,.3,1),background .18s,color .18s}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid var(--forest,#1f4d3b);outline-offset:3px;border-radius:4px}.ds-btn-apricot{background:var(--apricot,#e8834a);color:var(--ink,#1e2a26);border-color:var(--apricot,#e8834a)}.ds-btn-apricot:hover{background:var(--apricot-hover,#f0955f);color:var(--ink,#1e2a26)}"
